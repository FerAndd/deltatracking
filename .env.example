# Conexión a la base de datos (Supabase → Project Settings → Database → Connection string → "Transaction pooler")
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/delta

# Contraseña con la que Fer entra a la app
ADMIN_PASSWORD=cambia-esta-contraseña

# Texto largo y aleatorio para firmar la sesión (cualquier cadena de 32+ caracteres)
SESSION_SECRET=reemplaza-por-un-texto-largo-y-aleatorio-de-32-caracteres
